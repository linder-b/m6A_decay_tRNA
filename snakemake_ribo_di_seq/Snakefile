rule offset_generation:
    input:
      "mapping/{sample}_Unmapped.out_frame.txt"
    output:
      "mapping/{sample}_offset.txt"
    shell:
      '''
      if [[ {DATA_TYPE} == "monosome" ]]; then

          scripts/offset_generation.sh {input} {output} {EXTEND_NT}
      
      elif [[ {DATA_TYPE} == "disome" ]]; then

          scripts/offset_generation_disome.sh {input} {output} {EXTEND_NT}

      fi
      '''

rule codon_generation:
    input:
      CDS_FILE
    output:
      "Assign_Asite/{CDS_name}_codon_excluded.txt"
    priority: 100
    shell:
      "scripts/codon_file_generate.sh {input} {output} {EXTEND_NT} {EXCLUDE_CODONS}"

rule assign_Asite:
    input:
      offset_file="mapping/{sample}_offset.txt"
    params:
      outdir="Assign_Asite"
    log:
      report="Assign_Asite/{sample}_Assign_report.txt"
    output:    
      Asite_count="Assign_Asite/{sample}_Unmapped.out_codon_Asite_count.txt"
    shell:
      '''
      if [[ "{DATA_TYPE}" == "monosome" ]]; then
        
        scripts/rp_analysis.sh  -M WavePlot  -A {CDS_FILE}   -D {input.offset_file}  -O {params.outdir}  -E {EXTEND_NT} -F {EXCLUDE_CODONS} -B {EXCLUDE_CODONS} -a {output.Asite_count} 1>> {log}
      
      elif [[ {DATA_TYPE} == "disome" ]];then

         scripts/rp_analysis_disome.sh  -M WavePlot  -A {CDS_FILE}   -D {input.offset_file}  -O {params.outdir}  -E {EXTEND_NT} -F {EXCLUDE_CODONS} -B {EXCLUDE_CODONS} -a {output.Asite_count} 1>> {log}
      
      fi
      '''



rule coverage_generation:
    input:
      Asite_count="Assign_Asite/{sample}_Unmapped.out_codon_Asite_count.txt",
      codon_file = "Assign_Asite/" + CDS_name + "_codon_excluded.txt"
    log:
      report_cov="Assign_Asite/{sample}_Asite_count_coverage.log", 
      report_RPMcov="Assign_Asite/{sample}_Asite_count_RPM_coverage.log"
    output:
      RPM_cov="Assign_Asite/{sample}_Asite_count_RPM_coverage.txt",
      cov="Assign_Asite/{sample}_Asite_count_coverage.txt"
    shell:
      "scripts/coverage.sh {input.Asite_count} {input.codon_file} {output.cov} 1>> {log.report_cov} && " 
      "scripts/RPM_coverage.sh {input.Asite_count} {input.codon_file} {output.RPM_cov} 1>> {log.report_RPMcov}"



